---
// One catalogue card, rendered from the shared derivation in
// src/data/cards.mjs (states: live / dead / no-develop).
//
// Anatomy (all states, in order):
//   1. title row — human-readable label in a plain <h4> (no link) = the
//      manifest `description` (a single trailing « . » is stripped for the
//      h4 display ONLY — data-search/data-name keep the raw values) +
//      status badge (right);
//   2. subtitle (muted, monospace) — the repository name, directly under
//      the h4; not rendered when the description is empty (the repo name
//      then stays the h4, no subtitle);
//   3. meta row (muted) — filière tag (the content date moved to the
//      per-action date chips, spec 2026-10-24);
//   4. action band (visually separated) — Stable / Latest / Branches /
//      Source, ALL rendered on every card; unavailable actions are grayed
//      <button disabled> with the reason in `title`;
//   5. topic pill zone (filter toggles, distinct from the action band).
//
// State semantics (from the teaching-catalog v8.6 manifest):
//   live       — published develop: "Latest" links to the develop landing.
//   dead       — develop ref exists but the public site is not (or no
//                longer) reachable (the host is a DokuWiki catch-all, a 200
//                is not proof of publication): disabled "Latest" button +
//                "Non publié" chip — parity with teaching-catalog v8.6
//                (`btn-disabled title="non publie"`).
//   no-develop — no develop branch: disabled "Latest" button (title « pas
//                de branche develop »).
//
// "Stable" is rendered on EVERY card: the enabled link exists only when
// `releases_live && latest_vtag` (the tagged release is the published stable
// content); otherwise the action is a grayed disabled button (title « non
// publié » when a vtag exists but is not live, « aucun tag stable » when
// there is no vtag).
//
// "Branches": when the manifest lists branches, a native <details> dropdown
// enumerates them with the hybrid link rule (spec 2026-10-27, computed by
// branchHref() in cards.mjs): an item links to the render preview
// `SITE_BASE/<repo>/<branch>/` IFF the repo publishes a site (state 'live' —
// the manifest's `site_live` build-time probe, the same signal that enables
// the "Latest" link) AND the branch is `develop` or a `YYYY` year snapshot
// (org branch policy); every other item (feature/test branches, repos
// without a live site) keeps the GitHub source link
// `<github_url>/tree/<branch>`. The card keeps exactly one Source link to
// github.com; otherwise the action is a grayed disabled button
// (title « aucune branche listée ») — the same unavailable-action pattern
// as Stable/Latest.
//
// The `data-*` attributes power the client-side catalogue controls
// (search / category / topic / formation / filière filters / sort) on
// /catalog/:
//   data-catalog-card  — gate marker for page-level HTML audits
//   data-state         — live | dead | no-develop
//   data-name          — repo name (sort)
//   data-date          — full ISO date (date sorts; empty = undated)
//   data-search        — "name description" lowercased (text search)
//   data-topics        — space-joined non-system topics (AND filter)
//   data-formation     — formation axis slug ("" = none)
//   data-filiere       — filière axis slug ("" = none)
//
// Topic pills are filter TOGGLE buttons (progressive enhancement — inert
// without JS), sharing one active-topic Set with the Thèmes select and the
// "Filtres actifs" chip row (parity with teaching-catalog v8.6).
//
// Date captions (spec 2026-10-24, restyled as captions 2026-10-25,
// duration-as-default 2026-10-25): the Stable and Latest actions each
// carry a clickable CAPTION (visually subordinate, rendered UNDER the
// button it describes by CSS) when their manifest timestamp exists
// (`dates.stable` / `dates.latest` — no fallback).
// The server renders the ABSOLUTE FR date (`dd/MM/yyyy HH:mm`, build-time)
// as the visible text (no-JS fallback for users and crawlers); the raw ISO
// travels in `data-iso` and the scoped script below computes the RELATIVE
// duration (bare « N jours » / « N semaines » / « N mois » / « N an(s) » —
// no leading phrase) client-side: on load each caption switches to the
// DURATION as its default state, and every toggle re-computes with a fresh
// Date.now() — nothing relative is ever baked.
// The caption's `title` tooltip carries the French context sentence (NOT
// the date); the script rewrites `title` to match the displayed form:
// « … afficher la date » while the duration is shown, « … afficher
// l'ancienneté » while the absolute date is shown. The caption is a
// SIBLING of its action (inside `.card-action-group`), never a child of
// the button, so a caption click can never trigger the action's navigation.

import { STATUS_LABELS, branchHref } from '../data/cards.mjs';

interface Props {
  card: {
    name: string;
    description: string;
    status: string;
    category: string;
    formation: string;
    filiere: string;
    topics: string[];
    branches: string[];
    githubUrl: string;
    state: 'live' | 'dead' | 'no-develop';
    branch: string;
    landing: string;
    primary: string;
    releasesLive: boolean;
    latestVtag: string;
    stableUrl: string;
    date: string | null;
    dateFull: string | null;
    dateAbs: string | null;
    stableDateAbs: string | null;
    stableIso: string | null;
    latestIso: string | null;
    stableDateDT: string | null;
    latestDateDT: string | null;
  };
}

const { card } = Astro.props;
const { name, description, githubUrl, state } = card;
const badge = STATUS_LABELS[card.status] ?? null;
// Title/subtitle swap (spec 2026-10-25): the h4 carries the HUMAN-READABLE
// label = the manifest `description` (display-only — a single trailing « . »
// is stripped for the h4, never in the data-* attributes, which keep the
// raw values); the repository name drops to a muted monospace subtitle.
// Fallback: an empty/whitespace-only description keeps the repo name as h4
// and renders no subtitle.
const hasDescription = description.trim().length > 0;
const titleText = hasDescription ? description.replace(/\.$/, '') : name;
const hasStable = card.releasesLive && !!card.latestVtag;
const stableTitle = hasStable
  ? `Stable · ${card.latestVtag} · contenu du ${
      card.stableDateAbs ?? 'date inconnue'
    }`
  : card.latestVtag
    ? 'non publié'
    : 'aucun tag stable';
const latestTitle = state === 'dead' ? 'non publie' : 'pas de branche develop';
const branchesTitle = 'aucune branche listée';
// Date-caption tooltips (spec 2026-10-25): a French context sentence in
// `title` — NOT the date. The visible text stays the server-rendered
// absolute date, and the toggle script never rewrites `title`, so the
// sentence is static.
const stableCaptionTitle =
  "Date de la version stable — cliquer pour afficher l'ancienneté";
const latestCaptionTitle =
  "Dernière publication — cliquer pour afficher l'ancienneté";
---

<article
  class="card"
  class:list={[{ 'card--dead': state === 'dead' }]}
  data-catalog-card
  data-state={state}
  data-name={name}
  data-date={card.dateFull ?? ''}
  data-search={`${name} ${description}`.toLowerCase()}
  data-topics={card.topics.join(' ')}
  data-formation={card.formation}
  data-filiere={card.filiere}
>
  <div class="card-title-row">
    <h4 class="card-title">{titleText}</h4>
    {badge && <span class="badge">{badge}</span>}
  </div>
  {hasDescription && <p class="card-subtitle">{name}</p>}
  <p class="card-meta">
    {card.filiere && <span class="tag">{card.filiere}</span>}
  </p>
  <div class="card-actions">
    <span class="card-action-group">
      {hasStable ? (
        <a class="card-action card-action--stable" href={card.stableUrl} title={stableTitle}>
          Stable
        </a>
      ) : (
        <button type="button" class="card-action card-action--stable" disabled title={stableTitle}>
          Stable
        </button>
      )}
      {card.stableDateDT && (
        <span
          class="date-chip"
          role="button"
          tabindex="0"
          aria-pressed="false"
          data-iso={card.stableIso}
          title={stableCaptionTitle}>
          {card.stableDateDT}
        </span>
      )}
    </span>
    <span class="card-action-group">
      {state === 'live' ? (
        <a class="card-action card-action--latest" href={card.landing}>
          Latest
        </a>
      ) : (
        <button type="button" class="card-action card-action--latest" disabled title={latestTitle}>
          Latest
        </button>
      )}
      {card.latestDateDT && (
        <span
          class="date-chip"
          role="button"
          tabindex="0"
          aria-pressed="false"
          data-iso={card.latestIso}
          title={latestCaptionTitle}>
          {card.latestDateDT}
        </span>
      )}
    </span>
    {state === 'dead' && <span class="chip-off">Non publié</span>}
    {card.branches.length > 0 ? (
      <details class="card-branches">
        <summary class="card-action card-action--branches">Branches</summary>
        <ul class="card-branches-list">
          {card.branches.map((b) => (
            <li>
              <a href={branchHref(card, b)}>{b}</a>
            </li>
          ))}
        </ul>
      </details>
    ) : (
      <button type="button" class="card-action card-action--branches" disabled title={branchesTitle}>
        Branches
      </button>
    )}
    <a class="card-action card-action--source" href={githubUrl}>
      Source
    </a>
  </div>
  {card.topics.length > 0 && (
    <div class="card-pills">
      {card.topics.map((topic) => (
        <button
          type="button"
          class="chip-pill"
          data-topic={topic}
          aria-pressed="false"
          title={`Filtrer sur le thème : ${topic}`}>
          {topic}
        </button>
      ))}
    </div>
  )}
</article>

<script>
  // Date captions (spec 2026-10-24, caption restyle 2026-10-25,
  // duration-as-default 2026-10-25): clicking a caption toggles between
  // the RELATIVE duration (« aujourd'hui », « hier », « N jours »,
  // « N semaines », « N mois », « N an » / « N ans » — bare values, no
  // leading phrase) and the ABSOLUTE « dd/MM/yyyy HH:mm ». The server
  // renders the absolute form (progressive enhancement — without JS the
  // caption stays absolute); once the script runs, each caption switches
  // to the DURATION as its default state (aria-pressed="true"). The
  // duration is computed CLIENT-SIDE on load and re-computed with a fresh
  // Date.now() on every toggle — nothing relative is ever baked at build
  // time. `title` (the French context sentence) is rewritten by the
  // script to match the displayed form: « … afficher la date » while the
  // duration is shown, « … afficher l'ancienneté » while the absolute
  // date is shown. Each caption is a SIBLING of its action button
  // (stacked UNDER it by CSS), so a caption click can never trigger the
  // button's navigation.
  (() => {
    const chips = Array.from(
      document.querySelectorAll('.date-chip[data-iso]'),
    );
    if (chips.length === 0) return;

    // Europe/Paris pinned (not viewer-local) so the JS-toggled absolute form
    // stays byte-identical to the server-rendered caption.
    const absFmt = new Intl.DateTimeFormat('fr-FR', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/Paris',
    });

    const DAY = 86400000;

    const TITLES = {
      stable: {
        duration: "Date de la version stable — cliquer pour afficher la date",
        absolute: "Date de la version stable — cliquer pour afficher l'ancienneté",
      },
      latest: {
        duration: "Dernière publication — cliquer pour afficher la date",
        absolute: "Dernière publication — cliquer pour afficher l'ancienneté",
      },
    };

    // The chip's group also holds its action: the stable caption sits next
    // to `.card-action--stable`, every other caption next to
    // `.card-action--latest` — that selects the right sentence pair.
    function titlesFor(chip) {
      const group = chip.closest('.card-action-group');
      return group && group.querySelector('.card-action--stable')
        ? TITLES.stable
        : TITLES.latest;
    }

    function relFr(iso, now) {
      const t = new Date(iso).getTime();
      if (Number.isNaN(t)) return null;
      const startOfToday = new Date(now);
      startOfToday.setHours(0, 0, 0, 0);
      if (t >= startOfToday.getTime()) return "aujourd'hui";
      if (t >= startOfToday.getTime() - DAY) return 'hier';
      const d = Math.floor((now - t) / DAY);
      if (d < 7) return d > 1 ? `${d} jours` : `${d} jour`;
      if (d < 30) {
        const w = Math.floor(d / 7);
        return w > 1 ? `${w} semaines` : `${w} semaine`;
      }
      if (d < 365) return `${Math.max(1, Math.floor(d / 30))} mois`;
      const a = Math.floor(d / 365);
      return a > 1 ? `${a} ans` : `${a} an`;
    }

    function showDuration(chip) {
      const rel = relFr(chip.dataset.iso, Date.now());
      if (rel === null) return;
      chip.textContent = rel;
      chip.setAttribute('aria-pressed', 'true');
      chip.title = titlesFor(chip).duration;
    }

    function showAbsolute(chip) {
      chip.textContent = absFmt.format(new Date(chip.dataset.iso));
      chip.setAttribute('aria-pressed', 'false');
      chip.title = titlesFor(chip).absolute;
    }

    function toggle(chip) {
      if (chip.getAttribute('aria-pressed') === 'true') {
        showAbsolute(chip);
      } else {
        showDuration(chip);
      }
    }

    for (const chip of chips) {
      // Load-time pass: validate the embedded ISO, then switch the caption
      // to its default DURATION state (the absolute SSR text is what no-JS
      // users and crawlers see).
      if (relFr(chip.dataset.iso, Date.now()) === null) {
        chip.removeAttribute('tabindex');
        chip.setAttribute('aria-disabled', 'true');
        continue;
      }
      showDuration(chip);
      chip.addEventListener('click', () => toggle(chip));
      chip.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle(chip);
        }
      });
    }
  })();
</script>
