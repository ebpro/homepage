---
import manifest from '../data/manifest.json';
import Card from '../components/Card.astro';
import '../styles/global.css';

// Catalogue data is read at build time from the vendored manifest
// (src/data/manifest.json). Refresh with `npm run data`.
//
// Liveness: the fetched manifest (v8.x) carries only `releases_live`
// (booleans over release tags, all false here), not per-site liveness.
// Graceful degradation: every card links to the canonical published-site URL
// pattern https://bruno.univ-tln.fr/teaching-material/<repo>/<branch>/ plus a
// GitHub fallback. When the catalog ships liveness fields, gate the primary
// link on them here.

const SITE_BASE = 'https://bruno.univ-tln.fr/teaching-material/';

function siteUrl(repo) {
  const branch = repo.dates?.latest_ref || repo.default_branch || 'develop';
  return `${SITE_BASE}${repo.name}/${branch}/`;
}

// stub repos are scaffolds, not teaching material: excluded.
const repos = manifest.repos.filter((r) => r.status !== 'stub');

const lectures = repos.filter((r) => r.category === 'lecture');
const notebooks = repos
  .filter((r) => r.category === 'notebook')
  .sort((a, b) => a.name.localeCompare(b.name));
const samples = repos
  .filter((r) => r.category === 'sample')
  .sort((a, b) => a.name.localeCompare(b.name));

const STATUS_LABELS = {
  active: 'Actif',
  partial: 'Partiel',
  frozen: 'Gelé',
};

function formationLabel(formation) {
  if (formation === 'cnam') return 'CNAM';
  if (formation === 'utln') return 'Université de Toulon';
  return null;
}

const lectureGroups = [
  { formation: 'cnam', repos: lectures.filter((r) => r.formation === 'cnam') },
  { formation: 'utln', repos: lectures.filter((r) => r.formation === 'utln') },
  { formation: '', repos: lectures.filter((r) => !r.formation) },
].filter((g) => g.repos.length > 0);

function lastUpdated(repo) {
  const iso = repo.dates?.latest || repo.pushed_at;
  if (!iso) return null;
  return iso.slice(0, 10);
}
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Emmanuel Bruno, Maître de conférences, Université de Toulon</title>
    <meta
      name="description"
      content="Page personnelle d'Emmanuel Bruno, Maître de conférences à l'Université de Toulon, chercheur au LIS (UMR 7020). Enseignement en développement logiciel et architectures distribuées."
    />
    <!-- Pre-paint theme resolution: applies the pinned choice before first
         paint (no FOUC). Unpinned users follow prefers-color-scheme in CSS. -->
    <script is:inline>
      (() => {
        try {
          const s = localStorage.getItem("theme");
          if (s === "light" || s === "dark")
            document.documentElement.dataset.theme = s;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="Navigation principale">
        <a class="brand" href="#accueil">Emmanuel Bruno</a>
        <ul>
          <li><a href="#enseignement">Enseignement</a></li>
          <li><a href="#recherche">Recherche</a></li>
          <li><a href="#publications">Publications</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label="Basculer le thème clair/sombre"
          title="Thème clair / sombre">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4" />
          </svg>
        </button>
      </nav>
    </header>

    <main>
      <section id="accueil" class="hero">
        <h1>Emmanuel Bruno</h1>
        <p class="hero-role">Maître de conférences</p>
        <p class="hero-affiliation">
          Université de Toulon · UFR Sciences et Techniques<br />
          Chercheur au LIS (UMR 7020), équipe R2I, site de Toulon
        </p>
        <p class="hero-domains">
          Data Management · Information Retrieval · Large Language Models ·
          Multi-Agent Systems · Affective Computing
        </p>
        <ul class="hero-links">
          <li><a href="https://orcid.org/0000-0001-5171-2268">ORCID</a></li>
          <li><a href="https://dblp.org/pid/05/1898">DBLP</a></li>
          <li><a href="https://scholar.google.com/citations?user=TuDSngwAAAAJ">Google Scholar</a></li>
          <li><a href="https://github.com/emmanuelbruno">GitHub</a></li>
          <li><a href="mailto:emmanuel.bruno@univ-tln.fr">Email</a></li>
        </ul>
      </section>

      <section id="enseignement" class="page-section">
        <h2>Enseignement</h2>
        <p>
          Mes enseignements portent sur le développement logiciel et les
          architectures distribuées : programmation Java et objet, Git,
          intégration continue, services web REST, JPA, microservices,
          conteneurs, développement web et mobile. Les supports ci-dessous
          proviennent du catalogue pédagogique généré à partir de l'organisation
          GitHub <a href="https://github.com/ebpro">ebpro</a>
          (<time datetime={manifest.generated_at}>données du
          {manifest.generated_at.slice(0, 10)}</time>).
        </p>

        {lectureGroups.map((group) => (
          <div class="group">
            <h3>
              {group.formation
                ? `Cours, formation ${formationLabel(group.formation)}`
                : 'Autres cours'}
            </h3>
            <div class="grid">
              {group.repos.map((repo) => (
                <Card
                  repo={repo}
                  siteUrl={siteUrl(repo)}
                  statusLabel={STATUS_LABELS[repo.status]}
                  updated={lastUpdated(repo)}
                />
              ))}
            </div>
          </div>
        ))}

        <div class="group">
          <h3>Notebooks pédagogiques</h3>
          <div class="grid">
            {notebooks.map((repo) => (
              <Card
                repo={repo}
                siteUrl={siteUrl(repo)}
                statusLabel={STATUS_LABELS[repo.status]}
                updated={lastUpdated(repo)}
              />
            ))}
          </div>
        </div>

        <div class="group">
          <h3>Exemples et applications de démonstration</h3>
          <div class="grid">
            {samples.map((repo) => (
              <Card
                repo={repo}
                siteUrl={siteUrl(repo)}
                statusLabel={STATUS_LABELS[repo.status]}
                updated={lastUpdated(repo)}
              />
            ))}
          </div>
        </div>

        <p class="catalogue-link">
          Vue filtrable complète :
          <a href="https://bruno.univ-tln.fr/teaching-material/catalog/">catalogue pédagogique</a>.
        </p>
      </section>

      <section id="recherche" class="page-section">
        <h2>Recherche</h2>
        <!-- TODO: porter la description détaillée des axes de recherche depuis
             index.qmd (interaction humains-LLM, analyse des émotions) après
             validation de la structure de cette page. Contenu volontairement
             placeholder ici : ne rien inventer. -->
        <p class="placeholder">
          Description des axes de recherche en cours de portage. Détails actuels :
          <a href="https://www.lis-lab.fr/r2i">équipe R2I du LIS</a>.
        </p>
      </section>

      <section id="publications" class="page-section">
        <h2>Publications</h2>
        <!-- TODO: lister les publications sélectionnées. Source autorisée :
             index.qmd (section "Publications sélectionnées") et HAL
             (authIdPerson_i=174187). Aucune entrée ne doit être inventée ni
             recopiée sans relecture. -->
        <p class="placeholder">
          Liste des publications en cours de portage. Index complets :
          <a href="https://amu.hal.science/LIS-LAB/search/index/?q=%2A&amp;rows=30&amp;authIdPerson_i=174187&amp;sort=publicationDate_tdate+desc">HAL</a>,
          <a href="https://dblp.org/pid/05/1898">DBLP</a>,
          <a href="https://scholar.google.com/citations?user=TuDSngwAAAAJ">Google Scholar</a>.
        </p>
      </section>

      <section id="contact" class="page-section">
        <h2>Contact</h2>
        <div class="contact-grid">
          <div>
            <h3>Coordonnées</h3>
            <address>
              Emmanuel Bruno<br />
              Université de Toulon<br />
              Avenue de l'Université<br />
              BP 20132<br />
              83957 La Garde Cedex, France<br />
              <a href="https://bruno.univ-tln.fr">bruno.univ-tln.fr</a><br />
              <a href="mailto:emmanuel.bruno@univ-tln.fr">emmanuel.bruno@univ-tln.fr</a>
            </address>
          </div>
          <div>
            <h3>Clé PGP</h3>
            <p>
              Clé publique :
              <a href="https://bruno.univ-tln.fr/_media/contact/bruno_univ-tln.fr_2016_public.txt">
                <code>116C CE5F BA2C 0D37 D355 940E 400F 583C 1F81 2EDB</code>
              </a>
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>
        Emmanuel Bruno, Université de Toulon, LIS (UMR 7020).
        Catalogue : <time datetime={manifest.generated_at}>{manifest.generated_at.slice(0, 10)}</time>,
        {manifest.count} dépôts.
      </p>
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById("theme-toggle");
        if (!btn) return;
        const current = () =>
          root.dataset.theme ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        btn.addEventListener("click", () => {
          const next = current() === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try {
            localStorage.setItem("theme", next);
          } catch {}
        });
      })();
    </script>
  </body>
</html>
