---
import manifest from '../data/manifest.json';
import Card from '../components/Card.astro';
import { deriveCards } from '../data/cards.mjs';
import '../styles/global.css';

// Catalogue data is read at build time from the vendored manifest
// (src/data/manifest.json). Refresh with `npm run data`.
//
// Cards are derived by the shared module src/data/cards.mjs (states
// live / dead / no-develop from the v8.6 manifest `site_live`, deny-list
// applied, ordering = teaching-catalog default sort). The homepage shows the
// teaching-material subset: lectures, notebooks and samples — stub repos are
// scaffolds, not teaching material.

const cards = deriveCards(manifest);

const base = import.meta.env.BASE_URL;

// The five university courses are presented in the "Cours universitaires"
// table on this page; they must not appear twice as catalogue cards.
const tableCourses = [
  'lecture-UTLN-M1_Info_Math-DEV-OOCOL',
  'lecture-UTLN-M1_Info_Math-DEV-ADV',
  'lecture-UTLN-M2_Info_Math-DEV-EXP',
  'lecture-CNAM-MI_A2-PO43',
  'lecture-CNAM-MI_A2-PM44',
];

const shown = cards.filter(
  (c) =>
    (c.category === 'lecture' ||
      c.category === 'notebook' ||
      c.category === 'sample') &&
    c.status !== 'stub',
);

const lectures = shown.filter(
  (c) => c.category === 'lecture' && !tableCourses.includes(c.name),
);
const notebooks = shown.filter((c) => c.category === 'notebook');
const samples = shown.filter((c) => c.category === 'sample');

function formationLabel(formation) {
  if (formation === 'cnam') return 'CNAM';
  if (formation === 'utln') return 'Université de Toulon';
  return null;
}

const lectureGroups = [
  { formation: 'cnam', cards: lectures.filter((c) => c.formation === 'cnam') },
  { formation: 'utln', cards: lectures.filter((c) => c.formation === 'utln') },
  { formation: '', cards: lectures.filter((c) => !c.formation) },
].filter((g) => g.cards.length > 0);
---

<!doctype html>
<html lang="fr">
